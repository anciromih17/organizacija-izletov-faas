rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Prijave - lastnik bere svoje, admin bere vse; cancel dovoli lastnik, ostalo admin
    match /tripRegistrations/{id} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         request.auth.token.role == 'admin');
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        // Lastnik sme samo spremeniti status v "cancelled" ali naložiti dokument
        (resource.data.userId == request.auth.uid &&
          (request.resource.data.status == 'cancelled' ||
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['documentsUploaded', 'documentsUpdatedAt']))
        )
      );
    }

    // Izleti - vsi prijavljeni berejo, samo admin piše
    match /trips/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.role == 'admin';
    }

    // Obvestila - prijavljeni berejo; update samo polja "read" (označi kot prebrano)
    match /notifications/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null; // frontend ustvarja ob uploadu
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      // delete in ostale spremembe: samo Cloud Functions
    }

    // Dokumenti - lastnik ustvari, admin bere; frontend shrani ob uploadu
    match /storageDocuments/{id} {
      allow read: if request.auth != null &&
        (request.auth.token.role == 'admin' ||
         resource.data.registrationId != null);
      allow create: if request.auth != null;
    }

    // Uporabniki - vsak bere svoje, Cloud Functions pišejo
    match /users/{id} {
      allow read: if request.auth != null && request.auth.uid == id;
      allow write: if false;
    }

    // Event logi - samo branje za admin
    match /eventLogs/{id} {
      allow read: if request.auth != null &&
        request.auth.token.role == 'admin';
    }
  }
}
